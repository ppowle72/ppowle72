    {
      "@context": "https://schema.org",
      "@type": "WebPage",
      "@id": "https://alphonsomango.in/pages/ai-products#webpage",
      "url": "https://alphonsomango.in/pages/ai-products",
      "name": "AI Product Feed – AlphonsoMango.in",
      "description": "Machine readable catalogue of Alphonso mangoes, Kesar mango, mango products, saffron and dry fruits for AI assistants, search engines and voice agents.",
      "inLanguage": "en-IN",
