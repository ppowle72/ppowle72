{{ 'article.css' | asset_url | stylesheet_tag }}

<div class="container">
  {%- if section.settings.show_page_title -%}
    <div class="reading-width rte mb-6 md:mb-8 mt-10 md:mt-16 mx-auto">
      <h1 class="page__title lg:mt-8 {{ section.settings.heading_align }} {{ section.settings.heading_size }}">{{ page.title | escape }}</h1>
    </div>
  {%- endif -%}

  <div class="page__content reading-width rte article-content mt-12 mx-auto">
    {% render 'am-live-tokens', content: page.content %}
  </div>
</div>

{%- comment -%}
Page-specific JSON-LD for important static pages
{%- endcomment -%}

