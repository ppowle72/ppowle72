<style>
  .home-seo { padding: 1.5rem 0; }
  .home-seo__h { margin: 2rem 0 .75rem; }
  .home-seo__h:first-child { margin-top: 0; }
  .home-seo__steps { padding-left: 1.25rem; margin: 0 0 1rem; }
  .home-seo__steps li { margin-bottom: .5rem; }
  .home-seo__scroll { overflow-x: auto; margin: 0 0 1.25rem; }
  .home-seo__table { width: 100%; border-collapse: collapse; min-width: 480px; }
  .home-seo__table caption { text-align: left; font-weight: 600; padding-bottom: .4rem; }
  .home-seo__table th, .home-seo__table td { border: 1px solid rgba(128,128,128,.35); padding: .5rem .65rem; text-align: left; vertical-align: top; }
  .home-seo__table thead th { background: rgba(128,128,128,.12); }
  .home-seo__faq { border-bottom: 1px solid rgba(128,128,128,.35); padding: .6rem 0; }
  .home-seo__faq summary { cursor: pointer; font-weight: 600; }
  .home-seo__faq p { margin: .5rem 0 0; }
  .home-seo__reviewed { margin-top: 1.5rem; font-size: .85em; opacity: .75; }
</style>

