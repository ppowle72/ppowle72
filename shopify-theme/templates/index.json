            "star_rating": 4
          }
        },
        "template--16154615972040__747f5bec-2c63-4259-aa6c-b06cf8f3ed13-testimonial-3": {
          "type": "testimonial",
          "settings": {
            "testimonial": "<p>Totally reliable, trustworthy website and people. Received a nice discount on my mangoes. It was nicely packed and also got it delivered in time. So far, I have purchased 15 dozen mangoes from this website. 2-3 mangoes were spoilt but that’s very unpredictable what’s inside. Overall satisfied with my purchase</p>",
            "author": "GAURAV. S",
            "author_info": "",
            "show_star_rating": true,
            "star_rating": 5
          }
        },
        "testimonial_URAT4Y": {
          "type": "testimonial",
          "settings": {
            "testimonial": "<p>I ordered 2 dozens of Devgad mangoes from them out of which 4 mangoes were in bad condition. As my responsibility I informed them about this without expecting a refund. They were kind enough to add extra 4 mangoes in my next order.</p>",
            "author": "TRUSHITA. P",
            "author_info": "",
            "show_star_rating": true,
            "star_rating": 5
          }
        }
      },
