{%- comment -%} Live JudgeMe ratings {%- endcomment -%}
{%- if request.page_type == 'product' -%}
  {%- assign am_jm_rating = product.metafields.reviews.rating.value -%}
  {%- assign am_jm_count  = product.metafields.reviews.rating_count -%}
  {%- assign am_jm_max    = product.metafields.reviews.rating.value.scale_max | default: 5 -%}
  {%- assign am_jm_min    = product.metafields.reviews.rating.value.scale_min | default: 1 -%}
  {%- assign am_has_reviews = false -%}
  {%- if am_jm_rating != blank and am_jm_count != blank and am_jm_count > 0 -%}
    {%- assign am_has_reviews = true -%}
  {%- endif -%}
 
  {%- comment -%} FIX 2: "review" object alongside aggregateRating {%- endcomment -%}
  {%- if am_has_reviews -%}
    {%- capture am_rating -%}"aggregateRating":{"@type":"AggregateRating","ratingValue":"{{ am_jm_rating }}","reviewCount":"{{ am_jm_count }}","bestRating":"{{ am_jm_max }}","worstRating":"{{ am_jm_min }}"},"review":{"@type":"Review","reviewRating":{"@type":"Rating","ratingValue":"{{ am_jm_rating }}","bestRating":"{{ am_jm_max }}","worstRating":"{{ am_jm_min }}"},"author":{"@type":"Organization","name":"Verified Buyers — AlphonsoMango.in"},"reviewBody":"Rated {{ am_jm_rating }} out of {{ am_jm_max }} stars by {{ am_jm_count }} verified buyers. Authentic GI-tagged Alphonso mangoes from AlphonsoMango.in — carbide-free, Brix 18-22°."},
    {%- endcapture -%}
  {%- else -%}
    {%- assign am_rating = '' -%}
  {%- endif -%}
{%- endif -%}
 
